[Unit]
Description=Monad MCP node (%H)
After=network-online.target

[Service]
ExecStart=%h/monad-mcp/bin/current %h/monad-mcp/config/node.toml
Environment=RUST_LOG=info,monad_mcp_chorus=debug
KillSignal=SIGINT
# a crashed node stays down for inspection
Restart=no
LimitNOFILE=1048576

[Install]
WantedBy=default.target
