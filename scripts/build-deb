#!/usr/bin/env sh
set -eu

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
output_dir=${DEB_OUTPUT_DIR:-"$root_dir/dist"}
strip_symbols=${STRIP_SYMBOLS:-0}
stage_dir="$root_dir/target/debian/monad"

# --- version ---
version=${PACKAGE_VERSION:-$("$root_dir/scripts/package-version")}
case "$version" in
  *[!0-9A-Za-z.+:~\-]*) echo "Invalid Debian version: $version" >&2; exit 2 ;;
esac

cd "$root_dir"

# --- build ---
PACKAGE_VERSION="$version" "$root_dir/scripts/build-binaries"

# --- stage binaries ---
rm -rf "$stage_dir"
mkdir -p "$stage_dir/DEBIAN" "$stage_dir/usr/local/bin" "$stage_dir/usr/local/lib"

# Install binaries under the names the fleet expects: the ledger-tail,
# sign-name-record, and txgen examples gain a monad- prefix.
while read -r source name; do
  install -m 0755 "$source" "$stage_dir/usr/local/bin/$name"
done <<EOF
target/release/monad-node monad-node
target/release/monad-keystore monad-keystore
target/release/monad-debug-node monad-debug-node
target/release/monad-rpc monad-rpc
target/release/monad-archiver monad-archiver
target/release/monad-archive-checker monad-archive-checker
target/release/monad-indexer monad-indexer
target/release/monad-block-writer monad-block-writer
target/release/examples/ledger-tail monad-ledger-tail
target/release/examples/sign-name-record monad-sign-name-record
target/release/examples/txgen monad-txgen
target/release/examples/wal2json wal2json
target/release/examples/triedb-bench triedb-bench
monad-execution/build/category/mpt/monad-mpt monad-mpt
monad-execution/build/cmd/monad monad
monad-execution/build/cmd/monad-cli monad-cli
EOF

# --- stage libraries ---
# Ship libtriedb_driver.so plus the link closure of shared objects produced by
# this source tree (the patched Boost.Fiber, monad-execution, and friends);
# system libraries come from Depends. Copy to a fixpoint: staged copies win
# over build-tree RUNPATHs via LD_LIBRARY_PATH, so anything still resolving
# into the source tree is a build-produced dependency not yet bundled.
triedb=$(find target/release -name 'libtriedb_driver.so' -exec ls -Lt {} + | head -n 1)
test -n "$triedb" || { echo "libtriedb_driver.so not found under target/release" >&2; exit 2; }
cp "$triedb" "$stage_dir/usr/local/lib/"

while :; do
  unbundled=$(for obj in "$stage_dir"/usr/local/bin/* "$stage_dir"/usr/local/lib/*; do
      LD_LIBRARY_PATH="$stage_dir/usr/local/lib" ldd "$obj"
    done | awk -v root="$root_dir/" -v stage="$stage_dir/" \
      '$2 == "=>" && index($3, root) == 1 && index($3, stage) != 1 { print $3 }' | sort -u)
  [ -n "$unbundled" ] || break
  echo "$unbundled" | xargs -I {} cp {} "$stage_dir/usr/local/lib/"
done

if [ "$strip_symbols" = 1 ]; then
  find "$stage_dir/usr/local/bin" -type f -exec strip --strip-all {} \;
  find "$stage_dir/usr/local/lib" -type f -name '*.so*' -exec strip --strip-unneeded {} \;
fi

# --- check linkage ---
# Refuse to ship a package whose objects cannot start on a clean host: every
# dependency must be bundled in the stage dir or owned by a package named in
# Depends — never unresolved, never satisfied out of this source tree (which
# RUNPATHs make possible here but no target has), and never provided by a
# builder-image package the target was not told to install.
depends=$(sed -n 's/^Depends: *//p' debian/DEBIAN/control.in | tr ',' '\n' | awk '{print $1}')
for obj in "$stage_dir"/usr/local/bin/* "$stage_dir"/usr/local/lib/*; do
  bad=$(LD_LIBRARY_PATH="$stage_dir/usr/local/lib" ldd "$obj" \
    | grep -e 'not found' -e "=> $root_dir" | grep -v "=> $stage_dir" || true)
  if [ -n "$bad" ]; then
    echo "Unshippable linkage in $obj:" >&2
    echo "$bad" >&2
    exit 2
  fi
  # Only the object's direct NEEDED entries must be declared; dependencies of
  # the declared packages themselves (e.g. libarchive's zlib) come with apt.
  for lib in $(objdump -p "$obj" | awk '/NEEDED/ { print $2 }'); do
    path=$(LD_LIBRARY_PATH="$stage_dir/usr/local/lib" ldd "$obj" \
      | awk -v s="$lib" '$1 == s && $2 == "=>" { print $3 }')
    case "$path" in ''|"$stage_dir"/*) continue ;; esac
    owner=$(dpkg -S "$(readlink -f "$path")" 2>/dev/null | cut -d: -f1)
    if [ -z "$owner" ] || ! printf '%s\n' "$depends" | grep -qxF "$owner"; then
      echo "$obj needs $lib from '${owner:-no package}', which is not in Depends" >&2
      exit 2
    fi
  done
done

# --- debian metadata ---
cp -a debian/. "$stage_dir/"
sed -e "s/@PACKAGE_VERSION@/$version/" debian/DEBIAN/control.in > "$stage_dir/DEBIAN/control"
rm "$stage_dir/DEBIAN/control.in"

# --- package ---
mkdir -p "$output_dir"
dpkg-deb --root-owner-group --build "$stage_dir" "$output_dir/monad_${version}_amd64.deb"
