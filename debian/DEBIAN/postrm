#!/bin/sh
set -e

case "$1" in
  remove|purge)
    # Clear failed-state entries for our units so they don't linger in
    # `systemctl --failed` after removal.
    if command -v systemctl >/dev/null 2>&1 && [ "$(ps -p 1 -o comm=)" = "systemd" ]; then
      for svc in $(systemctl list-units --type=service --all --no-legend | awk '{print $1}' | grep '^monad-' || true); do
        systemctl reset-failed "$svc" || true
      done
    fi
    # NOTE: this intentionally leaves the backup keys folder and TrieDB
    # contents in place. To wipe TrieDB, run /opt/monad/scripts/wipe-triedb.sh
    # before removing the package.
    ;;
esac
