#!/usr/bin/env sh
set -eu

PACKAGE_VERSION=${PACKAGE_VERSION:?PACKAGE_VERSION must be set}
GIT_COMMIT=${GIT_COMMIT:?GIT_COMMIT must be set}
GIT_BRANCH=${GIT_BRANCH:?GIT_BRANCH must be set}
GIT_TAG=${GIT_TAG:?GIT_TAG must be set}
GIT_MODIFIED=${GIT_MODIFIED:?GIT_MODIFIED must be set}
GIT_COMMIT_HASH=${GIT_COMMIT_HASH:?GIT_COMMIT_HASH must be set}
export MONAD_VERSION="$PACKAGE_VERSION" GIT_COMMIT GIT_BRANCH GIT_TAG GIT_MODIFIED GIT_COMMIT_HASH

cd "$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"

export CC=gcc-15 CXX=g++-15
export LIBCLANG_PATH=/usr/lib/llvm-19/lib
export ASMFLAGS=-march=haswell
export CFLAGS=-march=haswell
export CXXFLAGS='-march=haswell -DQUILL_ACTIVE_LOG_LEVEL=QUILL_LOG_LEVEL_CRITICAL'

TRIEDB_TARGET=triedb_driver \
RUSTFLAGS='-C force-frame-pointers=yes -C target-cpu=haswell' \
cargo build --locked --release \
  --bin monad-node \
  --bin monad-keystore \
  --bin monad-debug-node \
  --bin monad-archiver \
  --bin monad-archive-checker \
  --bin monad-indexer \
  --bin monad-block-writer \
  --example ledger-tail \
  --example wal2json \
  --example triedb-bench \
  --example sign-name-record \
  --example txgen

cmake -S monad-execution -B monad-execution/build \
  -G Ninja \
  -DCMAKE_TOOLCHAIN_FILE:STRING="$PWD/monad-execution/category/core/toolchains/gcc-avx2.cmake" \
  -DCMAKE_BUILD_TYPE:STRING="${CMAKE_BUILD_TYPE:-RelWithDebInfo}" \
  -DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=TRUE

cmake --build monad-execution/build --target all
